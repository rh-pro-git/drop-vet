# Copied to ~/.config/drop-vet/env by deploy/install.sh. Every variable is optional.

# Where drops land and tiers live (landing/, quarantine/, ready/, unverified/, held/, rejected/, ledger.sqlite).
DROP_VET_ROOT=
# Where files with personal data go. Point it at an encrypted mount. Unset = such files are held instead.
# If the directory is missing at release time (volume not mounted) the batch stays in quarantine.
DROP_VET_SENSITIVE_DIR=
# ClamAV database directory written by the drop-vet-sigs unit.
DROP_VET_CLAMAV_DB=
# Where the signature freshness stamp lives.
DROP_VET_STATE_DIR=
# Refuse to release anything when signatures are older than this many days.
DROP_VET_SIG_MAX_AGE_DAYS=3
# Rejected files are deleted after this many days.
DROP_VET_PURGE_DAYS=14
# Optional command that receives one summary line as its last argument (counts and reason codes only),
# e.g. a script that posts to your chat app. Unset = no notifications.
DROP_VET_NOTIFY_CMD=
# History page bind address and port. Keep it on loopback and publish through a reverse proxy.
DROP_VET_HOST=127.0.0.1
DROP_VET_PORT=8750
